[ ca ]
default_ca = CA_default
[ CA_default ]
dir = ca
database = ca/index.txt
new_certs_dir = ca/newcerts
certificate = rsa-root.crt
private_key = rsa-root.key
serial = ca/serial
crlnumber = ca/crlnumber
default_md = sha256
default_days = 365
default_crl_days = 30
policy = policy_any
[ policy_any ]
commonName = optional
organizationName = optional
countryName = optional
